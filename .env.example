# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. Use a pooled URL (e.g. Neon/Supabase pooler) in production.
DATABASE_URL="postgresql://trustfolio:trustfolio@localhost:5432/trustfolio?schema=public"

# ─── Authentication (Auth.js) ───────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Trust the incoming Host header. Required for `next start`, Docker and other
# self-hosted setups behind a proxy you control. Vercel sets this automatically.
AUTH_TRUST_HOST=true

# Initial admin account used by `npm run db:seed` / `npm run admin:create`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Site Admin"

# ─── Public site ────────────────────────────────────────────────────────────
# Canonical origin, used for metadata, sitemap and Open Graph URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── File storage ───────────────────────────────────────────────────────────
# "local"  → writes to /public/uploads (development only; not persistent on Vercel)
# "vercel-blob" → Vercel Blob storage (recommended for production)
STORAGE_DRIVER="local"
# Required when STORAGE_DRIVER="vercel-blob" (created automatically when you link a Blob store on Vercel).
BLOB_READ_WRITE_TOKEN=""
# Max upload size in megabytes.
UPLOAD_MAX_MB="8"

# ─── Email notifications (optional) ─────────────────────────────────────────
# When set, new contact messages are emailed to CONTACT_NOTIFY_EMAIL via Resend.
RESEND_API_KEY=""
EMAIL_FROM="Trustfolio <notifications@example.com>"
CONTACT_NOTIFY_EMAIL="you@example.com"
